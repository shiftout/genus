# On the NAS this lives at /share/Container/genus/.env (outside the repo).
# Locally, export these or put them in a .env you don't commit.
GEMINI_API_KEY=
# Check the current free-tier model name in Google AI Studio before relying on the default.
GEMINI_MODEL=gemini-2.5-flash
# Gemini calls per day, for everyone together / per visitor IP. Cached answers are free.
LLM_DAILY_CAP=100
LLM_DAILY_CAP_PER_IP=10
RATE_LIMIT_PER_MIN=30
